+    }
+
+    advertising_window_active = true;
+    if (timeout_ms > 0) {
+        k_work_reschedule(&advertising_window_timeout_work, K_MSEC(timeout_ms));
+    } else {
+        k_work_cancel_delayable(&advertising_window_timeout_work);
+    }
+
